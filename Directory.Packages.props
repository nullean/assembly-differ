<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- the tool -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="Nullean.Argh" Version="0.18.0" />
    <PackageVersion Include="Proc" Version="0.9.1" />
    <PackageVersion Include="NuGet.Common" Version="7.9.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="7.9.0" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="NuGet.Resolver" Version="7.9.0" />
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <!-- under CPM the F# SDK adds no implicit FSharp.Core; Nullean.Make.Fs needs 11.0.100 or later -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <!-- brings its own Proc and Proc.Fs -->
    <PackageVersion Include="Nullean.Make.Fs" Version="0.25.0" />
  </ItemGroup>
</Project>

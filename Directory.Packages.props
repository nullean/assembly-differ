<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Nullean.PublicApi and Nullean.PublicApi.Diff on netstandard2.0 -->
  <ItemGroup>
    <PackageVersion Include="System.Reflection.Metadata" Version="11.0.0" />
    <PackageVersion Include="System.Collections.Immutable" Version="11.0.0" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
  </ItemGroup>

  <!-- the tool -->
  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Nullean.Argh" Version="0.30.1" />
    <PackageVersion Include="Proc" Version="0.22.1" />
    <PackageVersion Include="NuGet.Common" Version="8.0.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="8.0.0" />
    <PackageVersion Include="NuGet.Packaging" Version="8.0.0" />
    <PackageVersion Include="NuGet.Protocol" Version="8.0.0" />
    <PackageVersion Include="NuGet.Resolver" Version="8.0.0" />
    <PackageVersion Include="NuGet.Versioning" Version="8.0.0" />
    <!-- NuGet.Packaging pulls in 8.0.1, which has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <!-- tests/: TUnit, AwesomeAssertions and the snapshot packages track the latest stable release -->
  <ItemGroup>
    <PackageVersion Include="TUnit" Version="1.84.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="CsCheck" Version="5.0.1" />
    <PackageVersion Include="Nullean.Snapshots.AwesomeAssertions" Version="0.12.2" />
    <PackageVersion Include="Nullean.Snapshots.TUnit" Version="0.12.2" />
    <!-- compiles the old and new fixture assemblies a test diffs -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>

  <!-- benchmarks/ -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- build/scripts -->
  <ItemGroup>
    <!-- under CPM the F# SDK adds no implicit FSharp.Core; Runna.Fs needs 11.0.100 or later -->
    <PackageVersion Include="FSharp.Core" Version="11.0.101" />
    <!-- brings its own Proc and Proc.Fs -->
    <PackageVersion Include="Runna.Fs" Version="0.2.0" />
  </ItemGroup>
</Project>

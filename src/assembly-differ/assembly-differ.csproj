<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>assembly-differ</AssemblyName>
    <RootNamespace>AssemblyDiffer</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>assembly-differ</ToolCommandName>
    <RollForward>Major</RollForward>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\build\keys\keypair.snk</AssemblyOriginatorKeyFile>
    <Title>assembly-differ: a dotnet tool to diff assemblies</Title>
    <Description>Diff assemblies and nuget packages</Description>
    <PackageTags>api-diff;breaking-changes;semver;assembly;nuget;dotnet-tool;ci</PackageTags>

    <!-- Native-AOT tool packaging: one package per RID plus an 'any' framework-dependent fallback.
         The root package's DotnetToolSettings.xml (v2) maps each RID to its per-RID package.
         Installing requires the .NET 10 SDK or greater. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;win-arm64;osx-arm64;any</RuntimeIdentifiers>
    <!-- Lets `dotnet publish -f net10.0 -r <rid> -t:PublishContainer` containerize this same AOT
         publish output — see build/scripts/Targets.fs's publishContainers target and
         ghcr.io/nullean/assembly-differ. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>

  <!-- AOT settings apply only when a specific RID is targeted (dotnet pack -r <rid>). Without this
       guard they get baked into the runtimeconfig.json of the portable 'any' fallback too. Signing is
       skipped for the same reason: a native-AOT build has no loadable managed assembly to sign. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishAot>true</PublishAot>
    <PublishSelfContained>true</PublishSelfContained>
    <StripSymbols>true</StripSymbols>
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

  <!-- NuGet.Protocol deserialises feed JSON (service index, registration pages, repository
       signatures) with Newtonsoft.Json by reflection unless this feature switch is on. Under native
       AOT that reflection fails at run time, because trimming removes the constructors and
       properties it binds to (#62: no constructor for NuGet.Packaging.PackageDependencyGroup). With
       the switch, NuGet uses its source-generated System.Text.Json path instead, and Trim="true"
       lets the trimmer drop the Newtonsoft.Json path altogether. See
       https://github.com/NuGet/NuGet.Client/blob/dev/docs/aot-compatibility.md. It is set for the
       framework-dependent build too, so every build runs the same deserialisation code. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="NuGet.UseSystemTextJsonDeserialization" Value="true" Trim="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nullean.Argh" />
    <PackageReference Include="Proc" />
    <PackageReference Include="NuGet.Frameworks" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Resolver" />
    <PackageReference Include="NuGet.Common" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="JustAssembly.API, Version=0.0.0.1, Culture=neutral, PublicKeyToken=null">
      <HintPath>lib\JustAssembly.API.dll</HintPath>
    </Reference>
    <Reference Include="JustAssembly.Core, Version=0.0.7428.39699, Culture=neutral, PublicKeyToken=null">
      <HintPath>lib\JustAssembly.Core.dll</HintPath>
    </Reference>
    <Reference Include="JustAssembly.Infrastructure, Version=0.0.7428.37151, Culture=neutral, PublicKeyToken=null">
      <HintPath>lib\JustAssembly.Infrastructure.dll</HintPath>
    </Reference>
    <Reference Include="JustDecompile.External.JustAssembly, Version=2018.2.802.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>lib\JustDecompile.External.JustAssembly.dll</HintPath>
    </Reference>
    <Reference Include="JustDecompiler, Version=2018.2.802.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>lib\JustDecompiler.dll</HintPath>
    </Reference>
    <Reference Include="Telerik.JustDecompile.Mono.Cecil, Version=2018.2.802.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>lib\Telerik.JustDecompile.Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="Telerik.JustDecompile.Mono.Cecil.Mdb, Version=2018.2.802.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>lib\Telerik.JustDecompile.Mono.Cecil.Mdb.dll</HintPath>
    </Reference>
    <Reference Include="Telerik.JustDecompile.Mono.Cecil.Pdb, Version=2018.2.802.0, Culture=neutral, PublicKeyToken=null">
      <HintPath>lib\Telerik.JustDecompile.Mono.Cecil.Pdb.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
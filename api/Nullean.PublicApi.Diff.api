assembly Nullean.PublicApi.Diff
using Nullean.PublicApi: ApiAssembly
using System: Action<,>, FlagsAttribute, Version
using interface System: IEquatable<>
using System.Collections.Generic: Dictionary<,>, HashSet<>, ICollection<>, IEnumerable<>, IReadOnlyList<>

namespace Nullean.PublicApi.Diff
  [Flags]
  enum ApiAudience
    None = 0
    Callers = 1
    Implementers = 2
    Inheritors = 4

  sealed record ApiChange : IEquatable<ApiChange>
    ApiChange(IReadOnlyList<string> Path, ApiChangeKind Kind, string Part, string? Old, string? New, ApiAudience Breaks, ApiCompatibility Compatibility, bool Counts, string? Note)
    ApiAudience Breaks { get; init; }
    ApiCompatibility Compatibility { get; init; }
    bool Counts { get; init; }
    ApiChangeKind Kind { get; init; }
    SuggestedVersionChange Level { get; init; }
    string? New { get; init; }
    object? NewNode { get; init; }
    string? Note { get; init; }
    string? Old { get; init; }
    object? OldNode { get; init; }
    object? OldScope { get; init; }
    string Part { get; init; }
    IReadOnlyList<string> Path { get; init; }
    string Where { get; }
    ApiChange <Clone>$()
    void Deconstruct(out IReadOnlyList<string> Path, out ApiChangeKind Kind, out string Part, out string? Old, out string? New, out ApiAudience Breaks, out ApiCompatibility Compatibility, out bool Counts, out string? Note)
    bool Equals(ApiChange? other)
    override bool Equals(object? obj)
    override int GetHashCode()
    override string ToString()
    static bool operator ==(ApiChange? left, ApiChange? right)
    static bool operator !=(ApiChange? left, ApiChange? right)

  enum ApiChangeKind
    Added = 0
    Removed = 1
    Changed = 2

  static class ApiComparison
    static ApiComparisonResult Compare(ApiAssembly oldApi, ApiAssembly newApi, ApiComparisonOptions? options = null)

  sealed class ApiComparisonOptions
    ApiComparisonOptions()
    IReadOnlyList<string> NotExtensionPoints { get; init; }

  sealed class ApiComparisonResult
    IEnumerable<ApiChange> Breaking { get; }
    IReadOnlyList<ApiChange> Changes { get; }
    SuggestedVersionChange Suggest(Version? baseline = null)

  [Flags]
  enum ApiCompatibility
    None = 0
    Binary = 1
    Source = 2

  static class ApiDiff
    static IMetadataDiffItem? Compare(string oldAssemblyPath, string newAssemblyPath)

  sealed class AssemblyDiffItem : MetadataDiffItem
    override MetadataType MetadataType { get; }

  sealed class AssemblyReferenceDiffItem : MetadataDiffItem
    override MetadataType MetadataType { get; }

  sealed class CustomAttributeDiffItem : DiffItem
    override string HumanReadable { get; }
    override bool IsBreakingChange { get; }
    override void Visit(Action<IDiffItem, int> visit, int depth = 0)

  abstract class DeclarationDiffItem : DiffItem
    override void Visit(Action<IDiffItem, int> visit, int depth = 0)

  abstract class DiffItem : IDiffItem
    DiffType DiffType { get; }
    abstract string HumanReadable { get; }
    abstract bool IsBreakingChange { get; }
    string ToXml()
    abstract void Visit(Action<IDiffItem, int> visit, int depth = 0)

  enum DiffType : byte
    Deleted = 0
    Modified = 1
    New = 2

  interface IDiffItem
    DiffType DiffType { get; }
    string HumanReadable { get; }
    bool IsBreakingChange { get; }
    string ToXml()
    void Visit(Action<IDiffItem, int> visit, int depth = 0)

  interface IMetadataDiffItem : IDiffItem
    ICollection<IMetadataDiffItem> ChildrenDiffs { get; }
    int Count { get; }
    ICollection<IDiffItem> DeclarationDiffs { get; }
    MetadataType MetadataType { get; }

  sealed class MemberDiffItem : MetadataDiffItem
    bool AddsObligation { get; }
    override MetadataType MetadataType { get; }

  sealed class MemberTypeDiffItem : DeclarationDiffItem
    override string HumanReadable { get; }
    override bool IsBreakingChange { get; }

  abstract class MetadataDiffItem : DiffItem, IMetadataDiffItem, IDiffItem
    ICollection<IMetadataDiffItem> ChildrenDiffs { get; }
    int Count { get; }
    ICollection<IDiffItem> DeclarationDiffs { get; }
    override string HumanReadable { get; }
    override bool IsBreakingChange { get; }
    string? Key { get; }
    abstract MetadataType MetadataType { get; }
    string Name { get; }
    override void Visit(Action<IDiffItem, int> visit, int depth = 0)

  enum MetadataType : byte
    Assembly = 0
    Module = 1
    Type = 2
    Field = 3
    Method = 4
    Property = 5
    Event = 6
    AssemblyReference = 7

  sealed class ModuleDiffItem : MetadataDiffItem
    override MetadataType MetadataType { get; }

  sealed class ParameterDiffItem : DeclarationDiffItem
    override string HumanReadable { get; }
    override bool IsBreakingChange { get; }

  sealed class StaticFlagChangedDiffItem : DeclarationDiffItem
    override string HumanReadable { get; }
    override bool IsBreakingChange { get; }

  enum SuggestedVersionChange
    None = 1
    Patch = 2
    Minor = 3
    Major = 4

  sealed class TypeDiffItem : MetadataDiffItem
    override MetadataType MetadataType { get; }

  static class UsageFilter
    static IMetadataDiffItem? Apply(IMetadataDiffItem assembly, UsedApi used)

  sealed class UsedApi
    UsedApi()
    Dictionary<string, HashSet<string>> Members { get; }
    HashSet<string> Types { get; }
    static UsedApi Read(IEnumerable<string> assemblies, IEnumerable<string> packageAssemblies)
    bool UsesMember(string type, string member)

  static class VersionChange
    static SuggestedVersionChange Classify(IDiffItem item)

  sealed class VirtualFlagChangedDiffItem : DeclarationDiffItem
    override string HumanReadable { get; }
    override bool IsBreakingChange { get; }

  sealed class VisibilityChangedDiffItem : DeclarationDiffItem
    override string HumanReadable { get; }
    override bool IsBreakingChange { get; }
